# Copy to .env.local and adjust. Only VITE_* variables reach the browser — never put secrets here.

# Where user data and community content come from:
#   mock — the built-in fictional dataset plus this browser's localStorage (default; no backend needed)
#   http — the Rounds REST API at VITE_API_BASE_URL (see docs/BACKEND.md and docs/openapi.yaml)
VITE_API_MODE=mock

# Base URL of the Rounds API, used when VITE_API_MODE=http. Example: https://api.rounds.example/v1
VITE_API_BASE_URL=

# Europe PMC REST endpoint used by the "Live · Europe PMC" feed and paper search.
VITE_EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest

# Request timeout in milliseconds for both APIs.
VITE_REQUEST_TIMEOUT_MS=11500

# Mock mode only: artificial delay (ms) on every call, to exercise loading and pending states.
VITE_MOCK_LATENCY_MS=0
